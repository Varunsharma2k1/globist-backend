# Copy this file to .env and fill in real values for your machine.
# index.js loads this automatically via `require('dotenv').config()`.

# Port the local Express server listens on.
PORT=5001

# MongoDB connection string. If unset, the server falls back to an
# in-memory MongoDB instance (mongodb-memory-server) — fine for local
# development, but data resets every restart. Set this for anything
# persistent, including production.
MONGO_URI=

# Secret used to sign JWT access/refresh tokens. Must be set to a long,
# random value in production — the code falls back to an insecure default
# for local dev only.
JWT_SECRET=

# Comma-separated list of origins allowed to call this API (CORS).
# Defaults to localhost:5173 and localhost:3000 if unset.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Comma-separated Google OAuth client IDs (web/iOS/Android) accepted for
# "Continue with Google". Leave empty to disable Google sign-in.
GOOGLE_CLIENT_IDS=
