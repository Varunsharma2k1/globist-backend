# ════════════════════════════════════════════════════════════════════
#  Triptape server — every connection in the HLD.
#  Copy to .env and fill what you have. Anything left blank uses a safe
#  dev fallback, so the server always boots. Check with: npm run check:env
#  or GET /api/health/deps. Only src/config/env.js reads these.
#  NEVER commit .env. In production, load these from AWS SSM / secrets.
# ════════════════════════════════════════════════════════════════════

# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001
# Public URL of this API (used to build local upload URLs in dev).
PUBLIC_BASE_URL=http://localhost:5001
# Comma-separated CORS origins (web/admin portals). The mobile app needs none.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000
LOG_LEVEL=debug
# Seed demo regions/agencies/trips/reels into an empty database.
SEED_ON_EMPTY=true
# Demo tools for showcasing (e.g. "Mark trip as completed"). Ignored in production.
DEMO_TOOLS=true
# Tier 1 (one server): run background workers inside the API process.
RUN_WORKERS_IN_API=false

# ── Auth ────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Blank = insecure dev default (server refuses to start in production).
JWT_SECRET=
# Access token lifetime (seconds). The app refreshes it silently.
ACCESS_TOKEN_TTL_SEC=900
# Refresh token: a device stays signed in while it's used at least once in
# this many days, up to SESSION_MAX_DAYS, then the user signs in again.
REFRESH_TOKEN_TTL_DAYS=90
SESSION_MAX_DAYS=365
BCRYPT_ROUNDS=12
# Google Sign-In: the WEB OAuth client ID (the audience of the app's idToken).
# Add the iOS client ID later, comma-separated.
GOOGLE_OAUTH_CLIENT_IDS=

# ── MongoDB (current primary store) ─────────────────────────────────
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/triptape
# Blank = in-memory DB (dev only, wiped on restart). Required in production.
MONGO_URI=

# ── PostgreSQL (HLD primary — bookings/payments first) ──────────────
# Neon free tier (Tier 1) or RDS. Then run: npm run db:migrate
DATABASE_URL=
PG_POOL_MAX=10
PG_SSL=true

# ── Redis / Valkey (cache, rate limits, seat holds, BullMQ, sockets) ─
# Local: redis://localhost:6379   Upstash/ElastiCache: rediss://...
# Blank = in-process memory fallback (single server only).
REDIS_URL=

# ── Cloudflare R2 (media) + CDN ─────────────────────────────────────
# Blank = files saved to ./uploads and served by this API.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override (e.g. MinIO locally: http://localhost:9000)
R2_ENDPOINT=
R2_RAW_BUCKET=triptape-raw
R2_MEDIA_BUCKET=triptape-media
# Public CDN domain in front of the media bucket, e.g. https://media.triptape.app
CDN_BASE_URL=
UPLOAD_URL_TTL_SEC=900

# ── Razorpay (payments) ─────────────────────────────────────────────
# Test keys: dashboard.razorpay.com → Settings → API Keys.
# Blank = mock orders; confirm with POST /api/payments/mock/confirm.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://<api>/api/payments/webhook  (events: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# ── Firebase Cloud Messaging (push; Android first) ──────────────────
# Firebase console → Project settings → Service accounts → Generate key.
# Set ONE of these. Blank = pushes are logged instead.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── MSG91 (SMS OTP fallback) ────────────────────────────────────────
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=TRPTPE

# ── Amazon SES (email receipts / email OTP) ─────────────────────────
SES_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EMAIL_FROM=Triptape <no-reply@triptape.app>

# ── Google Maps / Places (server key, restricted to these APIs) ─────
GOOGLE_MAPS_API_KEY=

# ── Observability & analytics ───────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Rate limits (per user or IP, per window) ────────────────────────
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
